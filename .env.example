# Sports Scheduler Environment Configuration
PORT=5000
NODE_ENV=development

# Session & Security
SESSION_SECRET=supersecret_sports_scheduler_session_key_wd501_2026
COOKIE_SECURE=false

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sports_scheduler
DB_HOST=127.0.0.1
DB_PORT=5432
# Optional full connection URI:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/sports_scheduler

# Embedded PostgreSQL fallback (set true to auto-spawn embedded postgres binary if no host server is active)
USE_EMBEDDED_POSTGRES=true
